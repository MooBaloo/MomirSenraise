    <string name="settings_artwork">Artwork on slips</string>
    <string name="settings_artwork_hint">Prints the card\'s picture in the middle of the slip. A card with no artwork stored falls back to the QR layout.</string>
    <string name="settings_counts">Count the cards</string>
    <string name="settings_counts_hint">Shows how many cards the dial can land on under it. The line still appears when a category has none at all, because that is why the button is dead.</string>
    <string name="settings_copies">Copies per print</string>
    <string name="settings_slip_length">Slip length</string>
    <string name="settings_slip_length_hint">Every slip is printed to exactly this length, so they stack like cards. A Magic card is 88 mm.</string>
    <string name="settings_tear_gap">Head to tear bar</string>
    <string name="settings_tear_gap_hint">The distance from the print head to the tear bar. It is fed after every slip, and it is also the blank margin at the head, because that paper is already past the head when printing starts.</string>
    <string name="settings_bottom_margin">Margin at the foot</string>
    <string name="settings_bottom_margin_hint">Blank paper under the rules text, fed on top of the distance above. It comes out of the layout\'s space, not the slip\'s length.</string>
