    <!--
      One tally per category, and every line that counts cards is this phrase
      dropped into a frame - the count under the dial, the summary in the header,
      the empty-category line. That is what stops the app saying "creatures"
      while the dial is rolling planeswalkers.
    -->
    <plurals name="count_permanents">
        <item quantity="one">%1$s permanent</item>
        <item quantity="other">%1$s permanents</item>
    </plurals>
    <plurals name="count_creatures">
        <item quantity="one">%1$s creature</item>
        <item quantity="other">%1$s creatures</item>
    </plurals>
    <plurals name="count_artifacts">
        <item quantity="one">%1$s artifact</item>
        <item quantity="other">%1$s artifacts</item>
    </plurals>
    <plurals name="count_enchantments">
        <item quantity="one">%1$s enchantment</item>
        <item quantity="other">%1$s enchantments</item>
    </plurals>
    <plurals name="count_planeswalkers">
        <item quantity="one">%1$s planeswalker</item>
        <item quantity="other">%1$s planeswalkers</item>
    </plurals>
    <plurals name="count_spells">
        <item quantity="one">%1$s spell</item>
        <item quantity="other">%1$s spells</item>
    </plurals>

